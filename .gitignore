node_modules/
dist/
.env
.env.*
*.env

# ── Datos de cliente: NUNCA salen del disco local ────────────────────────────
# Regla negativa por defecto. Los LCM, exports y snapshots son sistemas
# financieros de clientes reales: no van a ningún remoto, ni siquiera privado.
clients/**
!clients/.gitkeep

# EPM Automate drops its per-command logs in the cwd
*_[0-9][0-9]_[0-9][0-9]_[0-9][0-9][0-9][0-9]_*.log

# Snapshots the rule deployer builds — they carry client rule scripts
DEPLOY_[0-9]*.zip
