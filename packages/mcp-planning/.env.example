# Non-sensitive profile settings
ORACLE_EPM_BASE_URL=https://example.epm.us-ashburn-1.ocs.oraclecloud.com
ORACLE_EPM_APPLICATION=NetSuite
ORACLE_EPM_CUBE=Plan
ORACLE_EPM_USERNAME=user@example.com

# Prefer an OS credential store in production. Environment variables are for local development.
ORACLE_EPM_PASSWORD=

# Path to a local, gitignored normalized LCM knowledge base.
ORACLE_EPM_KB_PATH=C:\path\to\tenant-kb.json

# Mutating tools are disabled unless this is explicitly enabled.
ORACLE_EPM_ENABLE_MUTATIONS=false
