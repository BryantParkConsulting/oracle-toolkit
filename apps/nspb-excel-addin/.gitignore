# ────────────────────────────────────────────────────────────────────
# .gitignore — NSPB MCP monorepo
# Layout:
#   add-in/      Excel add-in source
#   worker/      Cloudflare Worker source
#   docs-site/   Firebase Hosting docs site
#   tools/       LCM parser & dev utilities
#   clients/     Tenant KBs (only demo/ committed)
#   tests/, docs/, archive/, Customer_Installer/
# ────────────────────────────────────────────────────────────────────

# === SECRETS — never commit ======================================
claude-auth/
claude-auth/**
*.nspb-client.json          # client exports embed Essbase passwords
.env
.env.*
*.env
secrets/
**/credentials.json
**/wrangler.dev.toml
**/serviceAccountKey.json

# === Node / npm ==================================================
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json.bak

# === Cloudflare Workers (worker/) ================================
worker/bundle.js              # regenerated by `node build.js`
worker/.version               # cumulative build counter, local-only
worker/.wrangler/
.dev.vars

# === LCM raw exports (large, contains tenant data) ===============
lcm-export/

# === Tenant KBs — only ship demo, never real customer KBs ========
# Real customer tenant-kb.json files contain: form names, business rules,
# substitution variables, dimension members, and sometimes Essbase host
# URLs. Treat as customer-confidential, never push to git.
clients/*/tenant-kb.json
!clients/demo/tenant-kb.json

# === Archive — old/duplicates kept locally, not pushed ===========
archive/

# === docs-site (Firebase + Vite) =================================
docs-site/node_modules/
docs-site/dist/
docs-site/.firebase/
docs-site/firebase-debug.log

# === Customer_Installer artifacts ================================
Customer_Installer/install.log
Customer_Installer/help.zip

# === Test outputs ================================================
tests/uat-explain-report.json
tests/*-report.json
tests/screenshots/

# === IDE / editor ================================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# === OS / temp ===================================================
*.log
*.tmp
*.bak
*~
~$*.xlsx
~$*.xlsm
~$*.docx

# Excel scratch files in repo root
NSPB_Agent_Workbook.xlsx
*.xlsx
!Customer_Installer/*.xlsx

# Claude Code worktrees (auto-created branches for parallel agent runs)
.claude/worktrees/

# NSPB / Oracle exports — large binaries, contain client metadata
export_*.zip
*.zip
!Customer_Installer/*.zip

# === Legacy / superseded artifacts =================================
archive/
extension/config.local.js

# === Session additions (June 2026) ================================
# Chrome debug profile for extension live-testing — never commit
.chrome-debug-profile/
# UAT screenshots
tests/*.png
# Client analysis artifacts (confidential — non-demo client data stays out)
clients/*/level0*
clients/*/activity-report.json
clients/*/optimization-report.*
clients/*/deliverables/
clients/*/dynamic-calc-candidates.csv
clients/*/.*.b64
# Extension local config (holds the shared AI key)
extension/config.local.js
# BPC design system — only the assets the PDF pipeline needs are committed
desgincode/*
!desgincode/colors_and_type.css
!desgincode/SKILL.md
!desgincode/README.md
!desgincode/assets/
desgincode/assets/*
!desgincode/assets/logo/
!desgincode/assets/patterns/
!desgincode/assets/backgrounds/
desgincode/assets/backgrounds/*
!desgincode/assets/backgrounds/hero-skyline-nyc.png
.chrome-debug-profile-headless/
clients/talogy/
clients/squarespace/
Recording*.mp4

# EPM Automate — credenciales, nunca en el repo
*.epw
*.pass
.epm/
clients.json

# ── Datos de cliente: NADA sale del disco local ──────────────────────────────
# Antes esto eran patrones sueltos (clients/*/level0*, clients/talogy/, …) y
# dejaba 5.332 archivos expuestos a un `git add -A`: LCM completos de Enfinity,
# Symetri, DayWireless, Spindrift. Regla negativa por defecto, excepciones explícitas.
clients/**
!clients/demo/
!clients/demo/tenant-kb.json
