{
  "manifest_version": 3,
  "name": "NSPB AI — Planning Copilot",
  "version": "0.1.0",
  "description": "Side-panel AI chat for Oracle NSPB Planning. Talks to the NSPB Worker and can drive the real Planning console (open forms, navigate).",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "storage", "tabs", "scripting", "activeTab", "debugger"],
  "host_permissions": [
    "https://gentle-moon-046f.nspbassistant.workers.dev/*",
    "https://*.oraclecloud.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "NSPB AI — open side panel" },
  "side_panel": { "default_path": "sidepanel.html" },
  "web_accessible_resources": [
    {
      "resources": ["sidepanel.html", "sidepanel.js", "sidepanel.css", "navmap.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
